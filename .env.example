# ===== BARNBARN Workshop — ตั้งค่าระบบ (Configuration) =====
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง / Copy this file to ".env" and fill in real values.

# ---- ทั่วไป / General ----
PORT=3000
# รหัสผ่านสำหรับเข้าหน้าผู้ดูแล (Admin panel password). เปลี่ยนเป็นของคุณเอง!
ADMIN_PASSWORD=barnbarn2026
# ลิงก์เว็บของคุณ (ใช้สร้าง URL ยืนยัน). Public base URL of your site.
PUBLIC_BASE_URL=http://localhost:3000

# ---- ฐานข้อมูลถาวร / Persistent database (MongoDB Atlas) ----
# เว้นว่าง = เก็บข้อมูลในไฟล์ (จะรีเซ็ตเมื่ออัปเดตเว็บบน Render)
# ใส่ connection string จาก MongoDB Atlas = ข้อมูลถาวร ไม่หายเมื่ออัปเดต
# ตัวอย่าง: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# ---- Omise Payment Gateway (บัตรเครดิต + พร้อมเพย์) ----
# สมัครที่ https://dashboard.omise.co  (ใช้ test keys ขึ้นต้นด้วย _test_ ทดสอบก่อนได้)
# เว้นว่างไว้ = ระบบทำงานโหมดทดลอง (demo) ไม่ตัดเงินจริง
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# ---- LINE Official Account (Messaging API) ----
# สร้างที่ https://developers.line.biz  -> Messaging API channel
# เว้นว่างไว้ = ระบบจะบันทึกข้อความยืนยันไว้ในระบบ (คุณส่งเองผ่านแอป LINE OA)
LINE_CHANNEL_ACCESS_TOKEN=
# ลิงก์เพิ่มเพื่อน LINE OA ของคุณ (แสดงให้ผู้สมัครกดเพิ่มเพื่อน)
LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@yourbarnbarn
